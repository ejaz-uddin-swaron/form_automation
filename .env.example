# ── LLM Provider ──────────────────────────────────────────────
GEMINI_API_KEY=...your-gemini-key-here...
LLM_MODEL=gemini-3.5-flash

# ── Browser Settings ──────────────────────────────────────────
HEADLESS=false
MAX_AGENT_STEPS=30

# ── Sender Payload ────────────────────────────────────────────
SENDER_FIRST_NAME=Rashed
SENDER_LAST_NAME=Rahman
SENDER_EMAIL=rashed@example.com
SENDER_PHONE=+1-555-012-3456
SENDER_COMPANY=Acme Corp
SUBJECT_TEMPLATE=Partnership Inquiry from {company}
MESSAGE_BODY=Hello,\n\nI'm reaching out on behalf of {company} to explore potential collaboration opportunities. We'd love to schedule a brief call at your convenience.\n\nBest regards,\n{first_name} {last_name}
